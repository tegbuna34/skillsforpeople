# Supabase (server-side only — never expose service role key to client)
SUPABASE_URL=https://zihcxmfvxugobrvygmny.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Browser auth client (magic link). Same project URL as SUPABASE_URL.
# The anon key is safe to expose. Do not put the service role key here.
# Required on preview and production for sign-in. Without them, pages still
# render and the email forms say accounts open soon.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Production canonical origin only. Previews use the request origin for
# magic-link return URLs, so leave this unset on preview.
NEXT_PUBLIC_SITE_URL=https://www.skillsforpeople.com

# Kit newsletter page. Leave unset until the page exists.
# The button uses #newsletter-todo until this is a real URL.
NEXT_PUBLIC_NEWSLETTER_URL=

# Comma-separated emails allowed to download CSV exports at
# /api/admin/export?table=users and ?table=waitlist.
# Checked against the signed-in Supabase Auth user. Empty means nobody.
ADMIN_EMAILS=

# Optional Kit sync. Leave unset on preview unless you are testing Kit.
# A missing key is a no-op and never blocks signup or the waitlist.
# Tag IDs are numeric Kit tag ids. Preview should point at test tags.
KIT_API_KEY=
KIT_TAG_SFP_MEMBER=
KIT_TAG_WAITLIST_PEOPLE_BUILDERS=
KIT_TAG_PRIVATE_COHORT_INTEREST=
KIT_TAG_FOUNDING_COHORT=

# Legacy cookie secret for the pre-cutover sessions table. Unused after the
# magic-link cutover. Do not drop the sessions table until that is approved.
SESSION_SECRET=

# Set to "1" in local dev to render mock skills instead of hitting Supabase.
# Never set this in production.
USE_MOCK_SKILLS=

# ---- Notion (only needed to run scripts/migrate-notion-to-supabase.ts) ----
# Once the migration has been run and the site reads from Supabase, these can
# be removed from Vercel entirely.
NOTION_TOKEN=
NOTION_SKILLS_DATA_SOURCE_ID=dcf91c32-33a9-4b94-a07d-3ce9138a79c5
NOTION_EPISODES_DATA_SOURCE_ID=4119e42a-0a9e-4fc1-92ee-85e48aa0034f
NOTION_CONTRIBUTORS_DATA_SOURCE_ID=1c0b55bd-550c-4b84-951b-010c757e3073
